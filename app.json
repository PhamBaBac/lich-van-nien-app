{
  "expo": {
    "name": "An Lịch",
    "slug": "lich-van-nien-app",
    "scheme": "anlich",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8E161C",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#8E161C"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.phambabac.anlich",
      "adaptiveIcon": {
        "backgroundColor": "#8E161C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6b516048-349b-46f6-a7bc-6fe88e598ca2"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8E161C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#8E161C",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#8E161C"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableProguardInReleaseBuilds": false,
            "extraProguardRules": "-keep class com.reactnativeandroidwidget.** { *; }\n-keep class com.phambabac.anlich.widget.** { *; }\n-keep class androidx.work.** { *; }"
          }
        }
      ],
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LichNgay",
              "label": "Lịch Ngày Âm Dương (2x2)",
              "minWidth": "160dp",
              "minHeight": "160dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "description": "Xem ngày Dương, ngày Âm, Can Chi và Hoàng Đạo",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "LichChiTiet",
              "label": "Lịch Vạn Niên Chi Tiết (4x2)",
              "minWidth": "280dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Lịch Âm Dương đầy đủ, Giờ Hoàng Đạo và Tiết Khí",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
